#include <windows.h>
#include <winver.h>      // defines VS_VERSION_INFO; without it the version block below is silently ignored

// Tag every resource English (US): the version block below says 0409, and Windows ignores a block whose language
// does not match the resource's (the compiler otherwise uses the build machine's locale).
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// Everything the installer installs, packed by cadence_pack (see pack.cpp).
1 RCDATA "payload.bin"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Cadence installer"
            VALUE "ProductName", "Cadence"
            VALUE "CompanyName", "Cadence contributors"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "CadenceInstaller.exe"
            VALUE "FileVersion", "1.1.0"
            VALUE "ProductVersion", "1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
