#include <winres.h>

// Everything the installer installs, packed by cadence_pack (see pack.cpp).
1 RCDATA "payload.bin"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Cadence installer"
            VALUE "ProductName", "Cadence"
            VALUE "CompanyName", "Cadence contributors"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "CadenceInstaller.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
