# Build helper for Cadence mods. Works from this repo and from a standalone mod project:
#
#   set(CADENCE_SDK_DIR "path/to/cadence" CACHE PATH "")
#   include(${CADENCE_SDK_DIR}/cmake/CadenceMod.cmake)
#   cadence_add_mod(my_mod main.cpp
#       NAME "My Mod" AUTHOR "me" DESCRIPTION "Does a thing" KEY "M" VERSION "1.0")
#
# Produces my_mod.dll (target: my_mod_mod). Drop it in <GD>/mods/ and press F6 in game.
#
# NOT_BUNDLED keeps the mod out of the installer (for a mod you build in this tree but do not ship).
#
# The metadata options become the mod's `mod_info()` export, generated here so
# there is nothing to keep in sync by hand. All of them are optional.

if(NOT CADENCE_SDK_DIR)
    get_filename_component(CADENCE_SDK_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()

function(cadence_add_mod name)
    cmake_parse_arguments(MOD "NOT_BUNDLED" "NAME;AUTHOR;DESCRIPTION;KEY;VERSION" "" ${ARGN})
    set(sources ${MOD_UNPARSED_ARGUMENTS})

    if(NOT MOD_NAME)
        set(MOD_NAME "${name}")
    endif()
    set(json "{")
    foreach(pair "name:NAME" "author:AUTHOR" "desc:DESCRIPTION" "key:KEY" "ver:VERSION")
        string(REPLACE ":" ";" kv "${pair}")
        list(GET kv 0 field)
        list(GET kv 1 var)
        if(MOD_${var})
            string(REPLACE "\\" "\\\\" value "${MOD_${var}}")
            string(REPLACE "\"" "\\\"" value "${value}")
            if(NOT json STREQUAL "{")
                string(APPEND json ",")
            endif()
            string(APPEND json "\"${field}\":\"${value}\"")
        endif()
    endforeach()
    string(APPEND json "}")
    string(REPLACE "\\" "\\\\" cpp_json "${json}")
    string(REPLACE "\"" "\\\"" cpp_json "${cpp_json}")

    set(meta "${CMAKE_CURRENT_BINARY_DIR}/${name}_mod_info.cpp")
    file(WRITE "${meta}" "// Generated by cadence_add_mod(). Do not edit.\nextern \"C\" __declspec(dllexport) const char* mod_info() { return \"${cpp_json}\"; }\n")

    add_library(${name}_mod MODULE ${sources} "${meta}")
    # The installer (installer/) bundles every mod built in this tree unless it says NOT_BUNDLED.
    if(NOT MOD_NOT_BUNDLED)
        set_property(GLOBAL APPEND PROPERTY CADENCE_BUNDLED_MODS ${name}_mod)
    endif()
    target_include_directories(${name}_mod PRIVATE
        "${CADENCE_SDK_DIR}/loader/include"
        "${CADENCE_SDK_DIR}/generated/include")
    target_compile_features(${name}_mod PRIVATE cxx_std_20)
    set_target_properties(${name}_mod PROPERTIES
        PREFIX ""
        OUTPUT_NAME "${name}"
        SUFFIX ".dll"
    )
endfunction()
